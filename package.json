{
  "name": "slimpic",
  "version": "0.1.0",
  "description": "Compress, resize and convert images in the browser before upload: Web Worker, WebP/AVIF, exact target size, EXIF orientation, iOS-safe, HEIC plug-in. Drop-in replacement for browser-image-compression. React and Vue hooks.",
  "keywords": [
    "image",
    "compression",
    "compress",
    "resize",
    "webp",
    "avif",
    "heic",
    "upload",
    "browser-image-compression",
    "offscreencanvas",
    "web-worker",
    "react",
    "vue"
  ],
  "license": "MIT",
  "author": "Jose Alfonso Guerrero Juarez <ajuarez93> (https://www.ajuarez93.com)",
  "homepage": "https://github.com/ajuarez93/slimpic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajuarez93/slimpic.git"
  },
  "bugs": "https://github.com/ajuarez93/slimpic/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.js"
      },
      "require": {
        "types": "./dist/compat.d.cts",
        "default": "./dist/compat.cjs"
      }
    },
    "./heic": {
      "import": {
        "types": "./dist/heic.d.ts",
        "default": "./dist/heic.js"
      },
      "require": {
        "types": "./dist/heic.d.cts",
        "default": "./dist/heic.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "gen": "node scripts/build-worker.mjs",
    "build": "npm run gen && tsup",
    "typecheck": "npm run gen && tsc --noEmit",
    "test": "npm run gen && vitest run",
    "demo": "npm run gen && vite demo",
    "demo:build": "npm run gen && vite build demo",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "heic-to": ">=1.1",
    "react": ">=17",
    "vue": ">=3.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "heic-to": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "browser-image-compression": "^2.0.2",
    "esbuild": "^0.25.12",
    "heic-to": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "vue": "^3.5.46"
  }
}
