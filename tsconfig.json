{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "slimpic": ["./src/core/index.ts"],
      "slimpic/react": ["./src/react/index.ts"],
      "slimpic/vue": ["./src/vue/index.ts"],
      "slimpic/compat": ["./src/compat.ts"],
      "slimpic/heic": ["./src/heic.ts"]
    }
  },
  "include": ["src", "test", "demo/src"],
  "exclude": ["src/core/worker-entry.ts"]
}
